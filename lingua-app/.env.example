# PostHog product analytics + AI Observability (client and server share these).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Learning allowances: disabled by default. No scheduled automatic activation.
# Apply supabase/migrations/20261106_lesson_allowances.sql to a staging DB first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep off on the public app during this phase. Billing/AI endpoint authorization is a later phase.
LEARNING_ACCESS_MODE=off
# test mode requires staging and is rejected on Vercel production.
LEARNING_ACCESS_ENVIRONMENT=
# Random server-only secret of at least 32 characters; never NEXT_PUBLIC.
LEARNING_GUEST_SECRET=
# Optional comma-separated staging user UUIDs. Never honored in live mode.
LEARNING_TEST_PRO_USER_IDS=
