# PostHog product analytics + AI Observability (client and server share these).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Existing Supabase project. Server secret must never have a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1 defaults to off. Configure test ONLY on the preview deployment.
# off | test | production. The browser cannot select this value.
MONETIZATION_MODE=off
# Comma-separated auth.users UUIDs for dedicated test accounts (required in test mode).
MONETIZATION_TEST_USER_IDS=
# Generate a random value of at least 32 characters; keep stable across deployments.
GUEST_SIGNING_SECRET=
# Exact origin of THIS deployment, e.g. http://localhost:3000 (no trailing slash).
APP_ORIGIN=
# Optional: only if invoking POST /api/lesson/maintenance via an external scheduler.
GENERATION_MAINTENANCE_SECRET=
